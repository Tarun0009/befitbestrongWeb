# Runtime identity
NODE_ENV=development
APP_ENV=local
PORT=4000
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
RELEASE_SHA=""

# Required infrastructure
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5434/ecommerceweb?schema=public"
REDIS_URL="redis://localhost:6381"

# Exact comma-separated origins. Never use * with credentialed requests.
CORS_ORIGIN="http://localhost:3005"
FRONTEND_URL="http://localhost:3005"

# Prepaid orders reserve stock for this window. The worker scans in bounded batches.
CHECKOUT_RESERVATION_MINUTES=15
CHECKOUT_EXPIRY_SCAN_SECONDS=60
CHECKOUT_EXPIRY_BATCH_SIZE=50

# Re-check provider refunds that are pending or had an ambiguous HTTP result.
REFUND_RECONCILIATION_SCAN_SECONDS=300
REFUND_RECONCILIATION_BATCH_SIZE=25

# Firebase Admin SDK. Optional only for APP_ENV=local; configure all three together.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Preserve \n escapes and keep the value quoted.
FIREBASE_PRIVATE_KEY=""
# Local automated tests only. Use host:port with no protocol and a demo- project ID.
FIREBASE_AUTH_EMULATOR_HOST=""

# Razorpay. Optional only for APP_ENV=local; configure all three together.
# APP_ENV=production requires an rzp_live_ key.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Each attempt is bounded; only idempotency-safe operations are retried.
RAZORPAY_HTTP_TIMEOUT_MS=5000
RAZORPAY_HTTP_MAX_ATTEMPTS=3
RAZORPAY_HTTP_RETRY_BASE_MS=250

# Resend remains optional unless EMAIL_DELIVERY_REQUIRED=true.
RESEND_API_KEY=""
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=""
EMAIL_DELIVERY_REQUIRED=false
EMAIL_HTTP_TIMEOUT_MS=8000
EMAIL_OUTBOX_SCAN_SECONDS=30
EMAIL_OUTBOX_BATCH_SIZE=25
EMAIL_OUTBOX_MAX_ATTEMPTS=8

# Courier. Keep manual until a Shiprocket API user and webhook are ready.
COURIER_PROVIDER=manual
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_PICKUP_PINCODE=""
SHIPROCKET_WEBHOOK_SECRET=""
