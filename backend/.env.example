# Runtime identity
NODE_ENV=development
APP_ENV=local
PORT=4000
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
RELEASE_SHA=""

# Required infrastructure
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5434/ecommerceweb?schema=public"
REDIS_URL="redis://localhost:6381"

# Exact comma-separated origins. Never use * with credentialed requests.
CORS_ORIGIN="http://localhost:3005"
FRONTEND_URL="http://localhost:3005"

# Account security and privacy lifecycle.
ACCOUNT_RECENT_AUTH_MAX_AGE_SECONDS=300
ACCOUNT_EMAIL_CHANGE_TTL_MINUTES=60
ACCOUNT_DELETION_GRACE_DAYS=14
ACCOUNT_DELETION_SCAN_SECONDS=300
ACCOUNT_DELETION_BATCH_SIZE=20
ACCOUNT_SESSION_IDLE_DAYS=30

# Rate limiting. IP and account buckets are enforced together; backoff values
# are temporary retry delays, not permanent account lockouts.
RATE_LIMIT_AUTH_IP_MAX=10
RATE_LIMIT_AUTH_ACCOUNT_MAX=5
RATE_LIMIT_AUTH_WINDOW_SEC=60
RATE_LIMIT_AUTH_BACKOFF_BASE_SEC=5
RATE_LIMIT_AUTH_BACKOFF_MAX_SEC=300
RATE_LIMIT_PUBLIC_IP_MAX=120
RATE_LIMIT_PUBLIC_ACCOUNT_MAX=240
RATE_LIMIT_PUBLIC_WINDOW_SEC=60
RATE_LIMIT_PUBLIC_BACKOFF_BASE_SEC=2
RATE_LIMIT_PUBLIC_BACKOFF_MAX_SEC=60
RATE_LIMIT_AUTHENTICATED_IP_MAX=180
RATE_LIMIT_AUTHENTICATED_ACCOUNT_MAX=120
RATE_LIMIT_AUTHENTICATED_WINDOW_SEC=60
RATE_LIMIT_AUTHENTICATED_BACKOFF_BASE_SEC=1
RATE_LIMIT_AUTHENTICATED_BACKOFF_MAX_SEC=30
RATE_LIMIT_SERVICEABILITY_IP_MAX=30
RATE_LIMIT_SERVICEABILITY_ACCOUNT_MAX=60
RATE_LIMIT_SERVICEABILITY_WINDOW_SEC=3600
RATE_LIMIT_SERVICEABILITY_BACKOFF_BASE_SEC=5
RATE_LIMIT_SERVICEABILITY_BACKOFF_MAX_SEC=600

# Prepaid orders reserve stock for this window. The worker scans in bounded batches.
CHECKOUT_RESERVATION_MINUTES=15
CHECKOUT_EXPIRY_SCAN_SECONDS=60
CHECKOUT_EXPIRY_BATCH_SIZE=50
PAYMENT_RECONCILIATION_SCAN_SECONDS=30
PAYMENT_RECONCILIATION_BATCH_SIZE=25
PAYMENT_RECONCILIATION_INITIAL_DELAY_SECONDS=20
PAYMENT_RECONCILIATION_MAX_DELAY_SECONDS=300
PAYMENT_CREATED_GRACE_SECONDS=300
WEBHOOK_RECOVERY_MIN_AGE_SECONDS=60
WEBHOOK_RECOVERY_BATCH_SIZE=50

# Re-check provider refunds that are pending or had an ambiguous HTTP result.
REFUND_RECONCILIATION_SCAN_SECONDS=300
REFUND_RECONCILIATION_BATCH_SIZE=25

# Firebase Admin SDK. Optional only for APP_ENV=local; configure all three together.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Preserve \n escapes and keep the value quoted.
FIREBASE_PRIVATE_KEY=""
# Local automated tests only. Use host:port with no protocol and a demo- project ID.
FIREBASE_AUTH_EMULATOR_HOST=""

# Keep true for online payments. Set false for a deliberate COD-only launch
# while Razorpay is being onboarded. Existing deployments default to true.
PAYMENTS_ENABLED=true
# Razorpay credentials are required together only when PAYMENTS_ENABLED=true
# in a deployed environment. APP_ENV=production requires an rzp_live_ key.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Each attempt is bounded; only idempotency-safe operations are retried.
RAZORPAY_HTTP_TIMEOUT_MS=5000
RAZORPAY_HTTP_MAX_ATTEMPTS=3
RAZORPAY_HTTP_RETRY_BASE_MS=250

# Resend remains optional unless EMAIL_DELIVERY_REQUIRED=true.
RESEND_API_KEY=""
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=""
EMAIL_DELIVERY_REQUIRED=false
EMAIL_HTTP_TIMEOUT_MS=8000
EMAIL_OUTBOX_SCAN_SECONDS=30
EMAIL_OUTBOX_BATCH_SIZE=25
EMAIL_OUTBOX_MAX_ATTEMPTS=8

# Courier. Keep manual until a Shiprocket API user and webhook are ready.
COURIER_PROVIDER=manual
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_PICKUP_PINCODE=""
SHIPROCKET_WEBHOOK_SECRET=""
