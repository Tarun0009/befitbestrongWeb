# Copy to deploy/.env.production and keep that file out of version control.
# Use a long random value for each secret; never reuse local credentials.
# Database/Redis passwords are embedded in URLs, so use URL-safe A-Z/a-z/0-9/_/- characters.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password

# Exact public HTTPS origins, without a trailing slash.
PUBLIC_SITE_URL=https://shop.example.com
PUBLIC_API_URL=https://api.example.com
TRUST_PROXY_HOPS=1
RELEASE_SHA=replace-with-git-commit-sha

# CI publishes immutable images to GHCR. Keep the tag in RELEASE_SHA.
BACKEND_IMAGE=ghcr.io/tarun0009/befitbestrong-api
FRONTEND_IMAGE=ghcr.io/tarun0009/befitbestrong-web

# Firebase Admin SDK: copy individual JSON values, not the full JSON object.
FIREBASE_PROJECT_ID=replace-me
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# Firebase Web SDK: public identifiers compiled into the frontend bundle.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=example-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=example-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=example-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me

# Production refuses Razorpay test keys.
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-with-at-least-16-characters

# Optional. Set EMAIL_DELIVERY_REQUIRED=true only after both values are ready.
EMAIL_DELIVERY_REQUIRED=false
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
